# PRISM - Red Social Universitaria USMP Filial Sur
# Plantilla de variables de entorno

PORT=3000
NODE_ENV=development
SESSION_SECRET=secret_key_usmp_prism_2026

# Redis (Upstash REST API para Caché distribuido y Temp Data)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Administración: correos (separados por coma) que obtienen el rol admin
ADMIN_EMAILS=tu.correo@ejemplo.com

# Mapbox (Selector de ubicaciones interactivas en actividades)
MAPBOX_TOKEN=tu_token_de_mapbox_aqui

# Servicios opcionales. Sin ellos la app funciona con respaldo local.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEX=prism_contenido
QDRANT_URL=
QDRANT_API_KEY=
# Embeddings remotos (opcional): EMBEDDINGS_API_KEY, EMBEDDINGS_API_URL, EMBEDDINGS_MODEL
